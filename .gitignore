# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# gcp/.env.yaml has no secrets (only GOOGLE_CLOUD_PROJECT + ALLOWED_ORIGINS); safe to commit
!gcp/.env.yaml
# Cloud Build env files for the GCP uat/prod deploys - same story, no secrets
# (project id, Firestore db id, CORS origins). Real secrets come from Secret Manager.
!gcp/.env-gcp-uat.yaml
!gcp/.env-gcp-prod.yaml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.deploy

# firebase local cache (not for git)
.firebase/

# data backups (never commit — contains PII)
/backups/

# gcp/aws build artifacts
/lambda/function.zip
/gcp/node_modules/

# archived legacy code (safety net, not for git)
/_archive/
